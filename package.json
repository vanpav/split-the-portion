{
  "name": "split-the-portion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "pwa-assets-generator",
    "db:auth-schema": "WRANGLER_LOG=error node --no-deprecation scripts/auth-schema.mjs",
    "db:migrate:local": "wrangler d1 migrations apply split-the-portion --local",
    "db:migrate:preview": "wrangler d1 migrations apply split-the-portion-preview --remote --config wrangler.preview-db.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply split-the-portion --remote",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.7",
    "@fontsource-variable/rubik": "^5.3.0",
    "@use-gesture/react": "^10.3.1",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "driver.js": "^1.9.0",
    "hono": "^4.13.13",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.49.0",
    "nanoid": "^6.0.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-easy-crop": "^6.2.4",
    "react-i18next": "^17.0.16",
    "react-router": "^8.4.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "workbox-window": "^7.4.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-build": "^7.4.1",
    "wrangler": "^4.147.0"
  }
}
