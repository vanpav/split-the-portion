{
  // Cloudflare Workers: the built app as static files, /api/* handled by worker/index.ts (docs/CLOUDFLARE.md).
  "name": "split-the-portion",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // node:crypto for Better Auth: its password hash runs natively in workerd instead of slow pure JS.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // Only the API runs code; everything else is served as files (hash routes: the server only sees `/`).
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "split-the-portion",
      // Created by `pnpm wrangler d1 create split-the-portion` (docs/CLOUDFLARE.md §3), region WEUR.
      "database_id": "9ddc8c02-9162-4f45-929b-248ca1391a47",
      "migrations_dir": "worker/migrations"
    }
  ],
  // Rate limits of the API (worker/index.ts): per-location counters of Workers Rate Limiting.
  // Absent from previews (they only get the `previews` block), so the code treats them as optional.
  "ratelimits": [
    // Invite lookups before sign-in, per IP: stops guessing codes.
    { "name": "INVITES_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    // Syncs, per user: a normal client syncs every few seconds at most.
    { "name": "SYNC_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],
  // Preview builds of branches and pull requests. A preview deployment gets only the bindings of this
  // block: its own D1 (never the production one) and the auth secret from the account's Secrets Store,
  // since `wrangler secret put` values never reach previews (docs/CLOUDFLARE.md §8).
  "previews": {
    "secrets_store_secrets": [
      {
        "binding": "PREVIEW_AUTH_SECRET",
        "store_id": "d9d14f86567d45d5a82e830927b8f1db",
        "secret_name": "BETTER_AUTH_SECRET"
      }
    ],
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "split-the-portion-preview",
        // Created by `pnpm wrangler d1 create split-the-portion-preview` (docs/CLOUDFLARE.md §3), region WEUR.
        "database_id": "aa414161-a809-4629-ab47-6f0562341e1a",
        "migrations_dir": "worker/migrations"
      }
    ]
  }
}
